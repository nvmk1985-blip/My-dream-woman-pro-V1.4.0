  "spacing": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" }
  },
  "typography": {
    "pageTitle": { "$type": "fontSize", "$value": "26px" },
    "sectionHeading": { "$type": "fontSize", "$value": "20px" },
    "cardTitle": { "$type": "fontSize", "$value": "17px" },
    "body": { "$type": "fontSize", "$value": "15px" },
    "supporting": { "$type": "fontSize", "$value": "13px" },
    "metadata": { "$type": "fontSize", "$value": "12px" },
    "latinFontFamily": { "$type": "fontFamily", "$value": ["Inter", "sans-serif"] },
    "tamilFontFamily": { "$type": "fontFamily", "$value": ["Inter", "Noto Sans Tamil", "sans-serif"] }
  },
  "radius": {
    "base": { "$type": "dimension", "$value": "10px" }
  },
  "gradient": {
    "royalGold": {
      "$type": "gradient",
      "$value": { "type": "linear", "angle": "135deg", "stops": [
        { "color": "#8D6A32", "position": "0%" },
        { "color": "#D4AF6A", "position": "45%" },
        { "color": "#FFE8B0", "position": "70%" },
        { "color": "#B89555", "position": "100%" }
      ] }
    },
    "skyBlueNeon": {
      "$type": "gradient",
      "$value": { "type": "linear", "angle": "135deg", "stops": [
        { "color": "#168FA8", "position": "0%" },
        { "color": "#55DDF5", "position": "55%" },
        { "color": "#B6F5FF", "position": "100%" }
      ] }
    },
    "premiumDarkGlass": {
      "$type": "gradient",
      "$value": { "type": "linear", "angle": "145deg", "stops": [
        { "color": "rgba(28, 41, 46, 0.96)", "position": "0%" },
        { "color": "rgba(8, 11, 13, 0.96)", "position": "100%" }
      ] }
    }
  },
  "effect": {
    "goldGlowColor": { "$type": "color", "$value": "rgba(212, 175, 106, 0.24)" },
    "cyanGlowColor": { "$type": "color", "$value": "rgba(85, 221, 245, 0.24)" },
    "goldGlow": {
      "$type": "shadow",
      "$value": { "color": "rgba(212, 175, 106, 0.18)", "offsetX": "0px", "offsetY": "0px", "blur": "12px", "spread": "0px" }
    },
    "cyanGlow": {
      "$type": "shadow",
      "$value": { "color": "rgba(85, 221, 245, 0.20)", "offsetX": "0px", "offsetY": "0px", "blur": "14px", "spread": "0px" }
    }
  }
}
